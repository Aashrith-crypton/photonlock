  <text id="slide-number" x="72" y="42" width="190" height="24" font="caption" size="13" color="teal" wrap="false">05 / IMPACT &amp; BENEFITS</text>
  <text id="sih-mark" x="980" y="42" width="230" height="24" font="caption" size="13" color="muted" align="right" wrap="false">SIH 2026 · IDEA SUBMISSION</text>
